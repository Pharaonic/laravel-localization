{
  "name": "pharaonic/laravel-localization",
  "description": "Localized routing for Laravel: static locale-prefixed URLs for websites, and an ordered resolver pipeline for APIs.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "localization",
    "locale",
    "multilingual",
    "i18n",
    "localized routes",
    "accept-language",
    "hreflang"
  ],
  "homepage": "https://pharaonic.dev/packages/laravel/localization",
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "support": {
    "docs": "https://pharaonic.dev/packages/laravel/localization",
    "issues": "https://github.com/Pharaonic/laravel-localization/issues",
    "source": "https://github.com/Pharaonic/laravel-localization"
  },
  "require": {
    "php": ">=8.0 <8.2",
    "ext-intl": "*",
    "illuminate/console": "^8.75",
    "illuminate/container": "^8.75",
    "illuminate/contracts": "^8.75",
    "illuminate/http": "^8.75",
    "illuminate/routing": "^8.75",
    "illuminate/support": "^8.75"
  },
  "require-dev": {
    "laravel/pint": "^1.5",
    "orchestra/testbench": "^6.42",
    "pestphp/pest": "^1.23",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6.33"
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Laravel\\Localization\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Laravel\\Localization\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pharaonic\\Laravel\\Localization\\LocalizationServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/pest",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@format:check",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "abandoned": "report"
    },
    "policy": {
      "advisories": {
        "block": false,
        "ignore": {
          "laravel/framework": "No fixed release within Laravel 8; the application chooses the framework release.",
          "league/flysystem": "No fixed release within Laravel 8; the application chooses the framework release."
        }
      }
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
