{
  "name": "pharaonic/laravel-localization",
  "description": "Localized routing for Laravel: static locale-prefixed URLs for websites, and an ordered resolver pipeline for APIs.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "localization",
    "locale",
    "multilingual",
    "i18n",
    "localized routes",
    "accept-language",
    "hreflang"
  ],
  "homepage": "https://pharaonic.dev/packages/laravel/localization",
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "support": {
    "docs": "https://pharaonic.dev/packages/laravel/localization",
    "issues": "https://github.com/Pharaonic/laravel-localization/issues",
    "source": "https://github.com/Pharaonic/laravel-localization"
  },
  "require": {
    "php": ">=8.3 <8.6",
    "ext-intl": "*",
    "illuminate/console": "^13.0",
    "illuminate/container": "^13.0",
    "illuminate/contracts": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "illuminate/support": "^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.0",
    "phpstan/phpstan": "^2.1.33",
    "phpunit/phpunit": "^12.5.8"
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Laravel\\Localization\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Laravel\\Localization\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pharaonic\\Laravel\\Localization\\LocalizationServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/pest",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@format:check",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "abandoned": "report"
    },
    "policy": {
      "advisories": {
        "block": false
      }
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
